# Copy to ai_service/.env and fill in your API key and model name.
# The service reads .env at startup; restart after editing it.
# Server environment variables take priority over values in this file.
OPENAI_API_KEY=
# Model verified by the team with this service (Responses API + Structured Outputs + streaming).
# Replace it if your API project has no access to this model; any model with those features works.
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_OUTPUT_TOKENS=4000
