APP_NAME=Akim for 5 Hours API
APP_ENV=local
APP_DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_SECONDS=45
LOG_LEVEL=INFO
MAX_REQUEST_BODY_BYTES=262144
AI_CHAT_REQUESTS_PER_MINUTE=10
# Local PostgreSQL (same credentials as POSTGRES_* below and compose.yml).
# Without PostgreSQL see "Быстрый запуск" in the root README (SQLite preview).
DATABASE_URL=postgresql+asyncpg://xarabis:change_me@localhost:5432/xarabis
POSTGRES_DB=xarabis
POSTGRES_USER=xarabis
POSTGRES_PASSWORD=change_me
